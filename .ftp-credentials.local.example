# Kopie als ".ftp-credentials.local" speichern und ausfüllen.
# Diese Datei (.example) ist ok im Repo – die echte .local-Datei nicht.

FTP_HOST=ftp.dein-hoster.tld
FTP_USER=dein-benutzer
FTP_PASS=dein-passwort
FTP_REMOTE_DIR=/app
# Root-Domain ms365.schule (Ordner landing/ aus dem Repo)
FTP_LANDING_REMOTE_DIR=/
FTP_SECURE=false
