# Install-Skripte fremder Pakete nicht ausführen (Lieferketten-Schutz).
# Nebenwirkung: pre-/post-Hooks in package.json laufen ebenfalls nicht,
# deshalb ruft "npm run build" bzw. "npm run dev" scripts/vendor-libs.mjs direkt auf.
# Braucht ein Paket ausnahmsweise sein Install-Skript: npm rebuild <paket> --ignore-scripts=false
ignore-scripts=true
