  "dependencies": {
    "@azure/msal-browser": "3.26.1",
    "bootstrap-icons": "1.11.3",
    "jszip": "3.10.1",
    "mermaid": "11.17.2",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
