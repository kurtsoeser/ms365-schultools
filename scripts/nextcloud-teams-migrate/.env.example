# Kopie nach .env.local und Werte eintragen (niemals committen).

# Nextcloud Basis-URL ohne trailing slash
NEXTCLOUD_URL=https://www.dsrom-intranet.de

# Nextcloud-Loginname (oft E-Mail oder Kurzname – wie in der URL unter /dav/files/…)
NEXTCLOUD_USER=

# App-Passwort aus Personal → Security (nicht das normale Login-Passwort)
NEXTCLOUD_APP_PASSWORD=

# Entra / Graph (Device-Code). Leer = clientId aus ms365-config.js
GRAPH_TENANT_ID=organizations
# GRAPH_CLIENT_ID=

# Zielordner im Team-Dateien-Stamm
DEST_ROOT_FOLDER=Import aus Nextcloud
